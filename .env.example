# Required: generate these at https://testnet.binance.vision/ (Spot Testnet,
# not real funds/keys - never put mainnet API credentials here).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional overrides - defaults shown
# SYMBOL=btcusdt
# BINANCE_TESTNET_REST_URL=https://testnet.binance.vision
# BINANCE_TESTNET_WS_URL=wss://stream.testnet.binance.vision
# BINANCE_TESTNET_WS_API_URL=wss://ws-api.testnet.binance.vision/ws-api/v3

# Quoting (Avellaneda-Stoikov) params
# RISK_AVERSION=0.1
# ORDER_ARRIVAL_INTENSITY=1.5
# VOLATILITY=0.001
# TIME_HORIZON_S=3600
# MAX_INVENTORY=0.05
# QUOTE_SIZE=0.001

# Risk limits
# MAX_POSITION=0.05
# MAX_DAILY_LOSS=50
# MAX_STALE_DATA_MS=5000
# MIN_FILL_RATE=0.0
# MAX_FILL_RATE=1.0
# FILL_RATE_WINDOW=50
